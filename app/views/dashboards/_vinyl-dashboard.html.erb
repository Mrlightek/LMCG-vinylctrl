                <div class="booking-item__date-day">03</div>
                <div class="booking-item__date-month">May</div>
              </div>
              <div class="booking-item__info">
                <div class="booking-item__venue">Compound ATL</div>
                <div class="booking-item__meta">Fri · 11pm–4am · Hip-Hop</div>
              </div>
              <div class="status-pill status-pill--confirmed">Confirmed</div>
              <div class="booking-item__rate">$1,200</div>
            </div>
            <div class="booking-item">
              <div class="booking-item__date">
                <div class="booking-item__date-day">10</div>
                <div class="booking-item__date-month">May</div>
