      </div>
      <div class="sidebar__nav-item" onclick="navigate('messages')">
        <span class="sidebar__nav-icon">💬</span>Messages
        <span class="sidebar__badge">2</span>
      </div>

      <div class="sidebar__nav-section">Business</div>
      <div class="sidebar__nav-item" onclick="navigate('contracts')">
        <span class="sidebar__nav-icon">📄</span>Contracts
      </div>
      <div class="sidebar__nav-item" onclick="navigate('invoices')">
        <span class="sidebar__nav-icon">💰</span>Invoices
      </div>
      <div class="sidebar__nav-item" onclick="navigate('analytics')">
        <span class="sidebar__nav-icon">📈</span>Analytics
      </div>

      <div class="sidebar__nav-section">Profile</div>
      <div class="sidebar__nav-item" onclick="navigate('profile')">
        <span class="sidebar__nav-icon">👤</span>My Profile
      </div>
      <div class="sidebar__nav-item" onclick="navigate('availability')">
