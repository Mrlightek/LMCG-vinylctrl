<script>
function navigate(section) {
  document.querySelectorAll('.sidebar__nav-item').forEach(i => i.classList.remove('active'));
  event.currentTarget.classList.add('active');
  document.querySelector('.topbar__title').textContent = {
    bookings:'Bookings',gigs:'Find Gigs',messages:'Messages',
    contracts:'Contracts',invoices:'Invoices',analytics:'Analytics',
    profile:'My Profile',availability:'Availability',settings:'Settings'
  }[section] || 'Dashboard';
}
function switchTab(el) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}
</script>
